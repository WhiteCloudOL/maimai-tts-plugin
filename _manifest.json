{
  "manifest_version": 2,
  "id": "maimai-openai_tts_plugin",
  "version": "1.1.0",
  "name": "麦麦 OpenAI TTS",
  "description": "让麦麦通过 OpenAI 兼容的 audio/speech 端点合成并发送语音消息",
  "author": {
    "name": "清蒸云鸭",
    "url": "https://github.com/WhiteCloudOL"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/WhiteCloudOL/maimai-openai-tts-plugin",
    "homepage": "https://github.com/WhiteCloudOL/maimai-openai-tts-plugin",
    "documentation": "https://github.com/WhiteCloudOL/maimai-openai-tts-plugin/README.md",
    "issues": "https://github.com/WhiteCloudOL/maimai-openai-tts-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "pydantic",
      "version_spec": ">=2.0.0,<3.0.0"
    }
  ],
  "capabilities": [
    "send.hybrid"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "provider",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "audio-lines",
      "fallback": "volume-2",
      "background": "#EFF6FE"
    }
  }
}
