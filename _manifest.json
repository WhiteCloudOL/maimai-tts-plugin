{
  "manifest_version": 2,
  "id": "WhiteCloudOL.maimai-tts-plugin",
  "version": "2.0.1",
  "name": "麦麦多平台TTS语音",
  "description": "多平台文本转语音，内置插件WebUI，支持模型管理、音色管理、音频复刻等，支持OpenAI、阿里百炼、Minimax、火山引擎、BreezeTTS等多个API服务商",
  "plugin_type": "media",
  "author": {
    "name": "清蒸云鸭",
    "url": "https://github.com/WhiteCloudOL"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/WhiteCloudOL/maimai-tts-plugin",
    "homepage": "https://github.com/WhiteCloudOL/maimai-tts-plugin",
    "documentation": "https://github.com/WhiteCloudOL/maimai-tts-plugin/blob/main/README.md",
    "issues": "https://github.com/WhiteCloudOL/maimai-tts-plugin/issues"
  },
  "host_application": {
    "min_version": "1.3.6",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.13.0",
    "max_version": "2.20.0"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.9.0,<4.0.0"
    },
    {
      "type": "python_package",
      "name": "pydantic",
      "version_spec": ">=2.0.0,<3.0.0"
    },
    {
      "type": "python_package",
      "name": "av",
      "version_spec": ">=14.0.0,<17.0.0"
    },
    {
      "type": "python_package",
      "name": "silk-python",
      "version_spec": ">=0.2.8,<0.3.0"
    }
  ],
  "capabilities": [
    "send.hybrid",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "changelog": "changelog.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "speech",
      "background": "#D8EAD7"
    }
  }
}
